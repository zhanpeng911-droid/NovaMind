# NovaMind Environment Configuration
# Copy this file to .env and modify as needed

# ==================== Model Configuration ====================

# Default provider: openai, anthropic, aliyun, tencent, z.ai, ollama, other
DEFAULT_PROVIDER=openai

# Default model name
DEFAULT_MODEL=gpt-4o-mini

# ==================== OpenAI-Compatible Configuration ====================
# Applies to: OpenAI, Alibaba Cloud, Tencent Cloud, Z.AI, etc.

# API Key (required unless using Ollama)
OPENAI_API_KEY=sk-your-api-key-here

# Base URL (optional, leave empty for official endpoints)
# OpenAI: https://api.openai.com/v1
# Alibaba Cloud: https://dashscope.aliyuncs.com/compatible-mode/v1
# Tencent Cloud: https://api.hunyuan.cloud.tencent.com/v1

# ==================== Anthropic Configuration ====================
# Only when DEFAULT_PROVIDER=anthropic

# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==================== Ollama Configuration ====================
# Only when DEFAULT_PROVIDER=ollama

# OLLAMA_BASE_URL=http://localhost:11434

# ==================== NovaMind Configuration ====================

# Custom workspace path (optional, defaults to <project_root>/workspace)
# NOVAMIND_WORKSPACE=/path/to/workspace

# Middleware pipeline (comma-separated list of enabled middleware)
# NOVAMIND_MIDDLEWARE=token_tracker,logger,rate_limiter

# Log level: DEBUG, INFO, WARNING, ERROR
# NOVAMIND_LOG_LEVEL=INFO

# ==================== Multi-Agent Delegation (pi) ====================
# pi CLI available on PATH enables the delegate_to_pi tool automatically.

# pi command or full path (Windows npm installs should point to pi.cmd)
# NOVAMIND_PI_COMMAND=C:\npm-global\pi.cmd

# pi provider/model for delegation (custom providers via ~/.pi/agent/models.json)
# NOVAMIND_PI_PROVIDER=novamind
# NOVAMIND_PI_MODEL=deepseek-v4-flash

# ==================== Sandbox Configuration ====================
# Sandbox mode for the office toolset. Currently only "local" is supported;
# unknown values fail closed at startup. Docker mode lands after the image
# and a real smoke test are ready.
NOVAMIND_SANDBOX_MODE=local
